# Enter the discord webhook url
DISCORD_WEBHOOK_URL=your_discord_webhook_url
# Enter the discord role id for the role you want to ping
DISCORD_ROLE_ID=discord_id
# Log level (INFO by default if not set)
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# GitHub Token for exeding the rate limit (60 requests per hour for unauthenticated requests)
GITHUB_TOKEN=your_github_token
# Enable or disable the ping for updates
# Default is True if not set
ALLOW_PING=False
# Enable or disable ping for all releases
# Default is False if not set
# If set to True, it will ping for all releases, not just major ones
ALLOW_ALL_RELEASES_PING=False
